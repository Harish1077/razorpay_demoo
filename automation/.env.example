# Target Razorpay Demo Checkout URL (₹1.00 = 100 paise)
RAZORPAY_DEMO_URL=https://razorpay.com/demo/upi/

# Optional Customer Contact / Email for Razorpay Checkout pre-step
TEST_CONTACT=9876543210
TEST_EMAIL=qa.automation@example.com

# Live / Demo Card Credentials (replace with your own valid card for live 2FA/OTP)
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_EXPIRY=12/28
TEST_CARD_CVV=123
TEST_CARD_HOLDER=QA Automation

# UPI Virtual Payment Address (VPA)
TEST_UPI_VPA=success@razorpay

# NetBanking Target Bank
TEST_NETBANKING_BANK=HDFC

# Google Messages Web Persistent Profile Directory (for Bonus OTP flow)
MESSAGES_USER_DATA_DIR=.auth/messages-profile
MESSAGES_SENDER_FILTER=HDFC|SBI|ICICI|AXIS|KOTAK|BANK|RZRPAY

# Optional Slow-Motion delay in ms for clean demo video recordings
SLOW_MO=250
